# Rename this file to `.env.example` and commit it.
# It documents which vars devs need to set in their local .env.

# ── cca local ─────────────────────────────────────────────────────────
CCA_LOCAL_SUPERADMIN_USER=admin
CCA_LOCAL_SUPERADMIN_PASSWORD=

CCA_LOCAL_DB_HOST=localhost
CCA_LOCAL_DB_PORT=3306
CCA_LOCAL_DB_USER=root
CCA_LOCAL_DB_PASSWORD=root
CCA_LOCAL_DB_NAME=cca

# ── cca staging ───────────────────────────────────────────────────────
CCA_STAGING_SUPERADMIN_USER=admin
CCA_STAGING_SUPERADMIN_PASSWORD=

CCA_STAGING_DB_HOST=
CCA_STAGING_DB_PORT=3306
CCA_STAGING_DB_USER=
CCA_STAGING_DB_PASSWORD=
CCA_STAGING_DB_NAME=
