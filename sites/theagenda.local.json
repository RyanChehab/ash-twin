{
  "name": "theagenda",
  "env":  "local",
  "theme": "capetown",

  "baseUrl": "https://theagenda",
  "webUrl":  "https://theagenda",

  "users": {
    "superadmin": {
      "username": "${THEAGENDA_LOCAL_SUPERADMIN_USER}",
      "password": "${THEAGENDA_LOCAL_SUPERADMIN_PASSWORD}"
    },
    "testCustomer": {
      "username": "${THEAGENDA_LOCAL_TESTCUSTOMER_USER}",
      "password": "${THEAGENDA_LOCAL_TESTCUSTOMER_PASSWORD}"
    }
  },

  "db": {
    "host":     "${THEAGENDA_LOCAL_DB_HOST}",
    "port":     "${THEAGENDA_LOCAL_DB_PORT}",
    "user":     "${THEAGENDA_LOCAL_DB_USER}",
    "password": "${THEAGENDA_LOCAL_DB_PASSWORD}",
    "database": "theagenda"
  }
}
