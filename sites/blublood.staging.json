{
  "name": "blublood",
  "env":  "staging",
  "theme": "capetown",

  "baseUrl": "https://staging.blubloodtickets.com",
  "webUrl":  "https://staging.blubloodtickets.com",

  "users": {
    "superadmin": {
      "username": "${BLUBLOOD_STAGING_SUPERADMIN_USER}",
      "password": "${BLUBLOOD_STAGING_SUPERADMIN_PASSWORD}"
    },
    "testCustomer": {
      "username": "${BLUBLOOD_STAGING_TESTCUSTOMER_USER}",
      "password": "${BLUBLOOD_STAGING_TESTCUSTOMER_PASSWORD}"
    }
  },

  "db": {
    "host":     "${BLUBLOOD_STAGING_DB_HOST}",
    "port":     "${BLUBLOOD_STAGING_DB_PORT}",
    "user":     "${BLUBLOOD_STAGING_DB_USER}",
    "password": "${BLUBLOOD_STAGING_DB_PASSWORD}",
    "database": "blublood_staging"
  }
}
