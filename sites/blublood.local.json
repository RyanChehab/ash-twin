{
  "name": "blublood",
  "env":  "local",
  "theme": "capetown",

  "baseUrl": "https://blublood",
  "webUrl":  "https://blublood",

  "users": {
    "superadmin": {
      "username": "${BLUBLOOD_LOCAL_SUPERADMIN_USER}",
      "password": "${BLUBLOOD_LOCAL_SUPERADMIN_PASSWORD}"
    },
    "testCustomer": {
      "username": "${BLUBLOOD_LOCAL_TESTCUSTOMER_USER}",
      "password": "${BLUBLOOD_LOCAL_TESTCUSTOMER_PASSWORD}"
    }
  },

  "db": {
    "host":     "${BLUBLOOD_LOCAL_DB_HOST}",
    "port":     "${BLUBLOOD_LOCAL_DB_PORT}",
    "user":     "${BLUBLOOD_LOCAL_DB_USER}",
    "password": "${BLUBLOOD_LOCAL_DB_PASSWORD}",
    "database": "blublood"
  }
}
