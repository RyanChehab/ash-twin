{
  "name": "adrea",
  "env":  "local",
  "theme": "capetown",

  "baseUrl": "https://adrea",
  "webUrl":  "https://adrea",

  "users": {
    "superadmin": {
      "username": "${ADREA_LOCAL_SUPERADMIN_USER}",
      "password": "${ADREA_LOCAL_SUPERADMIN_PASSWORD}"
    },
    "testCustomer": {
      "username": "${ADREA_LOCAL_TESTCUSTOMER_USER}",
      "password": "${ADREA_LOCAL_TESTCUSTOMER_PASSWORD}"
    }
  },

  "db": {
    "host":     "${ADREA_LOCAL_DB_HOST}",
    "port":     "${ADREA_LOCAL_DB_PORT}",
    "user":     "${ADREA_LOCAL_DB_USER}",
    "password": "${ADREA_LOCAL_DB_PASSWORD}",
    "database": "adrea"
  }
}
